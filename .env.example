# Copy to .env.local and adjust. Every value is optional for local development.

# Secret used to encrypt stored OpenRouter keys and MCP credentials (AES-256-GCM).
# Generate one with:  openssl rand -base64 32
# REQUIRED in production. In development, if unset, one is generated into DATA_DIR/.app-secret.
# Changing it makes previously stored keys unreadable (users just reconnect).
APP_SECRET=

# Public origin of this app. Used for the OAuth callback and OpenRouter attribution headers.
APP_URL=http://localhost:3000

# Where the SQLite database, generated secret and agent file workspaces live.
DATA_DIR=./data

# Upstream endpoints (override only for testing or a proxy).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_AUTH_URL=https://openrouter.ai/auth

# Retries for 408/429/5xx and network errors (exponential backoff, honors Retry-After).
OPENROUTER_MAX_RETRIES=3

# Agent tools
# Tool calls allowed per minute per account. Also editable in Settings.
TOOL_RATE_LIMIT_PER_MIN=60
# Code sandbox limits (QuickJS in WebAssembly).
SANDBOX_TIMEOUT_MS=5000
SANDBOX_MEMORY_MB=64
# Let web_fetch / http_request / sandbox fetch reach private, loopback and link-local
# addresses. Off by default: model-chosen URLs must not be able to reach your network.
TOOLS_ALLOW_PRIVATE_NETWORK=false
